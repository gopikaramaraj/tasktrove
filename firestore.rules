
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if the user is the owner of the community
    function isCommunityOwner(communityId) {
      return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId;
    }

    function isCommunityMember(communityId) {
        return isAuthenticated() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    // Users Collection
    // - Anyone can create their own user document (on signup)
    // - Authenticated users can read public user profiles
    // - Users can only update or delete their own document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    // Communities Collection
    // - Authenticated users can read all public communities
    // - Authenticated users can create communities
    // - Only the owner can update or delete a community, except for memberCount
    match /communities/{communityId} {
      allow read, create: if isAuthenticated();
      allow update: if isCommunityOwner(communityId) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isCommunityOwner(communityId);

      // Community Members Subcollection
      // - Authenticated users can read the members list
      // - Users can join a community (create their own member doc)
      // - Users can only leave a community (delete their own member doc)
      // - Community owner can remove members
      match /members/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isCommunityOwner(communityId);
      }

      // Community Challenges Subcollection
      // - Authenticated users can read challenges
      // - The community owner can create or update challenges
      // - The community owner can delete challenges
      match /challenges/{challengeId} {
        allow read: if isAuthenticated();
        allow create: if isCommunityOwner(communityId);
        allow update: if (isCommunityOwner(communityId) || isCommunityMember(communityId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']);
        allow delete: if isCommunityOwner(communityId);
      }

      // Community Messages Subcollection
      // - Community members can read and create messages
      match /messages/{messageId} {
        allow create, get: if isCommunityMember(communityId);
        allow list: if isCommunityMember(communityId);
      }
    }
    
    // User Challenges Collection
    // - Track user progress in specific challenges
    // - Users can create their own user_challenge doc (join challenge)
    // - Users can only read their own user_challenge docs
    // - Users can only update their own user_challenge docs for progress
    // - Challenge participants can read other participants' progress for leaderboards
    match /user_challenges/{userChallengeId} {
        allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
        allow read: if isAuthenticated() && isOwner(resource.data.userId);
        allow update: if isAuthenticated() && isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'completedAt', 'xpGained']);
        allow list: if isAuthenticated();
    }

    // User Habits Collection
    // - Users can only manage their own habits
    match /user_habits/{userHabitId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && request.query.where[0][2] == request.auth.uid;
    }
  }
}
